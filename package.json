{
  "name": "hidori",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "next typegen && tsc --noEmit && eslint && node scripts/check-contrast.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "ship": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply hidori --local",
    "db:remote": "wrangler d1 migrations apply hidori --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "contrast-kit": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
